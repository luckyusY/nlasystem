# Public URL used for social metadata and allowed browser origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# The prototype stays deterministic when no provider key is present.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Enable only after a real identity provider or secure session store is wired.
AUTH_REQUIRED=false
JWT_SECRET=replace-with-a-long-random-secret

# Use a managed PostgreSQL service with PostGIS and pgvector for hosted data.
DATABASE_URL=postgresql://geoai:change-me@localhost:5432/nla_geoai
DATABASE_READONLY_URL=postgresql://geoai_reader:change-me@localhost:5432/nla_geoai
